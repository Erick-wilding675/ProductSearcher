# ProductSearcher, raiz: variáveis do ambiente de desenvolvimento.
# Copie para `.env` e ajuste. NÃO commite o `.env` (só este .example).
#   cp .env.example .env

# O que este arquivo faz, e o que ele NÃO faz.
#
# O `docker-compose.yml` fixa a `DATABASE_URL` dos serviços `api` e `worker` apontando
# para o Postgres do próprio compose. Ele NÃO lê a `DATABASE_URL` daqui, de propósito:
# assim `docker compose up` sempre sobe um ambiente local coerente, sem risco de a API do
# container falar com o banco de produção por causa de um `.env` esquecido.
#
# Deste arquivo o compose usa apenas `DB_PORT`. A `DATABASE_URL` abaixo serve às
# ferramentas que rodam no host, como `python infra/check_db.py`.
#
# Cada projeto tem o seu próprio `.env`, com escopo diferente:
#   api/.env      DATABASE_URL e CORS usados pela API e pelo Alembic (`make migrate`)
#   worker/.env   DATABASE_URL da ingestão e as chaves das ferramentas offline
#   frontend/.env NEXT_PUBLIC_API_URL

# Porta que o Postgres do compose publica no host. Mude se a 5432 já estiver ocupada:
#   DB_PORT=5433 docker compose up -d db api
# Dentro da rede do compose os serviços continuam falando com `db:5432`.
DB_PORT=5432

# Banco alvo das ferramentas que rodam no host (não dos containers).
# Local, igual ao que o compose sobe:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/productsearcher
# Para apontar ao Supabase, use o POOLER DE SESSÃO (5432) em DDL e carga, e o de
# transação (6543) só em runtime de leitura. Ver api/.env.example.

# IA é complementar e fica desligada por padrão (princípio 1 do projeto).
AI_ENABLED=false

# Origens que podem chamar a API. Sem curinga: o CORSMiddleware compara string exata.
CORS_ORIGINS=["http://localhost:3000"]

# URL da API para o web app em dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
