# ProductSearcher — api: variáveis de ambiente.
# Copie para `.env` e preencha. NÃO commite o `.env` (só este .example).
#   cp .env.example .env

# Conexão do Postgres/Supabase usada pelo Alembic (migrations) e pela API.
# IMPORTANTE: para MIGRATIONS e a CARGA do seed use o POOLER DE SESSÃO (porta 5432),
# não o de transação (6543) — o pooler de transação quebra DDL e prepared statements.
# Deixe a 6543 para o runtime da API depois.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# SENHA: evite `%`, `@`, `/` e `#`. Na URL eles têm significado próprio — `%B6`, por
# exemplo, é lido como escape percentual e vira o byte 0xB6, então o banco recebe uma
# senha diferente da que você colou. Ou gere uma senha alfanumérica, ou percent-encode
# (`%` → `%25`) antes de montar a URL.

# PRODUÇÃO (ADR-0011): o banco vive em sa-east-1, junto do backend no Fly, e o runtime
# usa a 6543. Estas duas variáveis não moram aqui — são `flyctl secrets`:
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
#   CORS_ORIGINS=["https://productsearcher.vercel.app"]

# CORS — clientes que podem chamar a API (ver app/core/config.py).
# Web app: lista JSON de origens EXATAS. Curinga (`*.vercel.app`) não funciona: o
# CORSMiddleware compara a origem como string (ADR-0011 D5).
CORS_ORIGINS=["http://localhost:3000"]
# Extensão de browser: regex das origens de extensão (id não é fixo em dev).
CORS_ORIGIN_REGEX=^(chrome-extension|moz-extension)://[a-z0-9]+$
